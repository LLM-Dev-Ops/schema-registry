# Node modules (if any)
node_modules/

# Cache directories
.cache/
__pycache__/

# Kubernetes/Helm configs (separate deployment)
deployments/kubernetes/
helm/

# Local development
.devcontainer/
docker-compose*.yml

# Benchmark binaries (but not the crate itself)
/benches/
